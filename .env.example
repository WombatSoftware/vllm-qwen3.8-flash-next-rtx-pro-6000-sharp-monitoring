# Copy to .env and edit. docker compose auto-loads .env from this directory.
# .env is gitignored -- keep it that way, it holds credentials.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Directory containing the checkpoint. The engine expects the model at
#   $MODELS_DIR/dicksondickson/Qwen3.8-Flash-Next-NVFP4-reshard-mtp-fix
# Mounted read-only. See README "Get the checkpoint".
MODELS_DIR=~/models

# Kernel/compile caches, persisted across container recreates so that every
# restart does not re-JIT FlashInfer and rebuild the torch.compile cache.
HF_CACHE_DIR=~/.cache/huggingface
VLLM_CACHE_DIR=~/.cache/vllm
TORCH_CACHE_DIR=~/.cache/torch
FLASHINFER_CACHE_DIR=~/.cache/flashinfer

# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------
# Which physical GPU to hand the container. This recipe is single-GPU (TP=1).
GPU_DEVICE_ID=0

# ---------------------------------------------------------------------------
# Exposure
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps each service host-local. Setting any of these to 0.0.0.0
# publishes on every interface: the vLLM endpoint is UNAUTHENTICATED and so is
# Prometheus. Prefer an SSH tunnel:
#   ssh -L 8000:127.0.0.1:8000 -L 3000:127.0.0.1:3000 <gpu-host>
VLLM_BIND=127.0.0.1
VLLM_PORT=8000
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Only needed if you let the container download gated weights itself. Leave
# empty when the checkpoint is already on disk under MODELS_DIR.
HF_TOKEN=

# Seeds the Grafana admin account the FIRST time the grafana-data volume is
# created. Changing it later does nothing; rotate with:
#   docker exec qwen-3-8-flash-next-grafana grafana cli admin reset-admin-password '<new>'
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
